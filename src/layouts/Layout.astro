---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { clinicInfo } from '../utils/clinicInfo';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/600.css';
import 'swiper/css';
import 'swiper/css/pagination';
import 'aos/dist/aos.css';

export interface Props {
  /** Unbranded page title. The layout appends the practice name once. */
  title: string;
  /** Full control of <title>. When set, the layout uses it verbatim. */
  seoTitle?: string;
  /** Robots directive. Omit on indexable pages; set "noindex, follow" on 404. */
  robots?: string;
  /** Load reCAPTCHA. Only pages with a form need it. */
  needsRecaptcha?: boolean;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  modifiedDate?: string;
  serviceSchema?: object;
}

const {
  title,
  seoTitle,
  robots,
  needsRecaptcha = false,
  description = "NextGen Dental is a top-rated family and cosmetic dentist in South Austin (78747). Gentle exams, cleanings, implants, Invisalign, and emergency care.",
  image,
  canonical = Astro.url.pathname,
  type = 'website',
  publishDate,
  modifiedDate,
  serviceSchema
} = Astro.props;

// Get IDs from .env
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;

// Astro.site is set in astro.config.mjs; fallback should never fire but keep it pointing at the right domain.
const siteUrl = Astro.site ? Astro.site.toString().slice(0, -1) : "https://nextgendentalaustintx.com";
const fullCanonical = `${siteUrl}${canonical}`;
// OG image: per-page image when provided, otherwise the branded sitewide
// default card (1200x630) so every shared link gets a proper preview.
const ogImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/images/og-default.jpg`;

// Page title. Pages pass an UNBRANDED `title`; the brand is appended exactly once
// here. A page may pass `seoTitle` to control the whole string. The `includes`
// guard keeps this idempotent if a branded title is ever passed by mistake, so the
// duplication this replaced ("... | NextGen Dental | NextGen Dental Austin, TX")
// cannot silently return.
const pageTitle = seoTitle
  ? seoTitle
  : title.includes(clinicInfo.name)
    ? title
    : `${title} | ${clinicInfo.name}`;

// Build opening hours from clinicInfo so schema stays in sync with displayed hours.
// Schema.org expects 24h "HH:MM" format; our source data is "08:30 AM – 5:00 PM" style.
// Days that are "Closed" or "By Appointment Only" are intentionally omitted.
const dayRangeRegex = /^(\d{1,2}):(\d{2})\s*(AM|PM)\s*[–-]\s*(\d{1,2}):(\d{2})\s*(AM|PM)$/i;
const to24h = (h: string, m: string, ampm: string) => {
  let hour = parseInt(h, 10);
  if (/pm/i.test(ampm) && hour !== 12) hour += 12;
  if (/am/i.test(ampm) && hour === 12) hour = 0;
  return `${String(hour).padStart(2, '0')}:${m}`;
};
const openingHoursSpecification = Object.entries(clinicInfo.hours)
  .map(([day, value]) => {
    const match = value.match(dayRangeRegex);
    if (!match) return null; // skips "Closed", "By Appointment Only", etc.
    const [, oH, oM, oA, cH, cM, cA] = match;
    return {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": day,
      "opens": to24h(oH, oM, oA),
      "closes": to24h(cH, cM, cA),
    };
  })
  .filter(Boolean);

const dentistSchema = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  "@id": siteUrl,
  "name": clinicInfo.name,
  "image": `${siteUrl}/images/logo.png`,
  "url": siteUrl,
  "telephone": clinicInfo.phone,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": clinicInfo.address.line1,
    "addressLocality": clinicInfo.address.city,
    "addressRegion": clinicInfo.address.state,
    "postalCode": clinicInfo.address.zip,
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": clinicInfo.coordinates.latitude,
    "longitude": clinicInfo.coordinates.longitude
  },
  "openingHoursSpecification": openingHoursSpecification,
  // Only verified profiles belong in sameAs — an unverified URL asserts an entity
  // relationship to search engines that may not exist.
  "sameAs": [
    clinicInfo.social.facebook,
    clinicInfo.social.yelp
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={clinicInfo.name} />
    <meta name="keywords" content="dentist, dental care, Austin dentist, teeth cleaning, dental implants, cosmetic dentistry, family dentist, emergency dental care, Austin TX" />

    <link rel="canonical" href={fullCanonical} />
    {robots && <meta name="robots" content={robots} />}

    <!-- Social Meta Tags -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:site_name" content={clinicInfo.name} />
    <meta property="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta property="twitter:url" content={fullCanonical} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <!-- Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(dentistSchema)} />
    {serviceSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    )}

    <!-- DNS Prefetch for third-party domains -->
    <link rel="dns-prefetch" href="https://www.google.com" />
    <link rel="dns-prefetch" href="https://www.gstatic.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Preload critical assets -->
    <!-- Font preloads removed deliberately. @fontsource CSS is bundled by Vite, which
         content-hashes the .woff2 filenames, so a hardcoded /_astro/<name>.woff2 path
         cannot be correct. The previous tags also used as="style" (wrong for fonts) and
         omitted crossorigin, so they warned in the console and preloaded nothing. The
         modulepreload of /src/components/Hero.astro pointed at a source path that does
         not exist in the build. If font preloading is wanted, generate the tags at build
         time from the emitted asset names. -->


    <slot name="head" />
    <Analytics />

    <style is:global>
      :root {
        font-display: swap;
      }
    </style>
  </head>
  <body class="antialiased bg-gray-50 text-gray-800 min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- AOS Animation - Deferred -->
    <script>
      setTimeout(() => {
        import('aos').then((AOS) => {
          AOS.default.init({ duration: 800, easing: 'ease-in-out', once: true, mirror: false });
        });
      }, 100);
    </script>

    <!-- ✅ GOOGLE ADS & ANALYTICS: DELAYED LOAD -->
    <!-- This trick improves Lighthouse score by waiting 3 seconds before loading trackers -->
    {googleAdsId && (
      <script is:inline define:vars={{ googleAdsId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}

        // 1. Set config immediately (so it's ready when script loads)
        gtag('js', new Date());
        gtag('config', googleAdsId, { 'anonymize_ip': true }); // Added for privacy/best practice

        // 2. Load the actual script after a delay
        setTimeout(() => {
          const script = document.createElement('script');
          script.src = `https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`;
          script.async = true;
          document.head.appendChild(script);
          console.log('Google Ads/Analytics loaded lazily.');
        }, 3500); // 3.5 second delay (Lighthouse finishes audit before this runs)
      </script>
    )}

    <!-- ✅ RECAPTCHA: LAZY LOAD (Already implemented) -->
    {needsRecaptcha && recaptchaSiteKey && (
      <script is:inline define:vars={{ recaptchaSiteKey }}>
        window.isRecaptchaLoaded = false;
        function loadRecaptcha() {
          if (window.isRecaptchaLoaded) return;
          window.isRecaptchaLoaded = true;
          const script = document.createElement('script');
          script.src = `https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`;
          script.async = true;
          script.defer = true;
          document.head.appendChild(script);
        }
        function initLazyLoad() {
          const forms = document.querySelectorAll('form.recaptcha-form, #contact-form, #appointment-form');
          forms.forEach(form => {
            form.addEventListener('mouseenter', loadRecaptcha, { once: true });
            form.addEventListener('focusin', loadRecaptcha, { once: true });
            form.addEventListener('touchstart', loadRecaptcha, { once: true });
          });
          setTimeout(loadRecaptcha, 4000);
        }
        function onRecaptchaReady() { console.log("reCAPTCHA ready"); }
        document.addEventListener('DOMContentLoaded', initLazyLoad);
        const checkInterval = setInterval(() => {
          if (typeof grecaptcha !== 'undefined') { clearInterval(checkInterval); onRecaptchaReady(); }
        }, 500);
      </script>
    )}
  </body>
</html>
