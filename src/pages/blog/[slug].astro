---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import { blogPosts } from '../../utils/blogPosts';
import { clinicInfo } from '../../utils/clinicInfo';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: post.title, href: `/blog/${post.id}` },
];

const pageTitle = post.seoTitle || post.title;
const pageDescription = post.seoDescription || post.excerpt;
const siteUrl = Astro.site ? Astro.site.toString() : 'https://nextgendentalaustintx.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

// Image handling for OG tags and hero
const isAstroImage = post.image && typeof post.image === 'object' && 'src' in post.image;
const ogImage = isAstroImage
  // @ts-ignore
  ? new URL(post.image.src, siteUrl).toString()
  : new URL('/images/hero/dental-2.jpg', siteUrl).toString();

const imageAlt = post.imageAlt || post.title;

// Dates
const publishedISO = new Date(post.date).toISOString();
const modifiedISO = new Date(post.dateModified || post.date).toISOString();
const showUpdated = post.dateModified && post.dateModified !== post.date;
const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Related posts: same category first, then most recent others (max 2)
const related = [
  ...blogPosts.filter(p => p.id !== post.id && p.category === post.category),
  ...blogPosts.filter(p => p.id !== post.id && p.category !== post.category),
].slice(0, 2);

// BlogPosting structured data
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": pageDescription,
  "image": ogImage,
  "datePublished": publishedISO,
  "dateModified": modifiedISO,
  "author": {
    "@type": "Person",
    "name": post.author,
    "jobTitle": "Dentist",
    "worksFor": { "@type": "Dentist", "name": clinicInfo.name }
  },
  "publisher": {
    "@type": "Dentist",
    "name": clinicInfo.name,
    "url": siteUrl,
    "telephone": clinicInfo.phone
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  type="article"
  image={ogImage}
  publishDate={publishedISO}
  modifiedDate={modifiedISO}
>
  {/* Article-specific head tags via the Layout head slot. The previous
      template passed an `og` prop Layout does not accept, so article
      metadata was silently dropped. */}
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedISO} />
    <meta property="article:modified_time" content={modifiedISO} />
    <meta property="article:author" content={post.author} />
    <meta property="article:section" content={post.category} />
    {post.tags && post.tags.map(t => <meta property="article:tag" content={t} />)}
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  </Fragment>

  {/* Spacer clears the fixed header; the generic hero banner was removed to
      put the article first and cut page weight on every blog post. */}
  <div class="pt-32">
    <Breadcrumbs items={breadcrumbItems} class="py-4 bg-gray-50 border-b border-gray-200" />
  </div>

  <div class="py-12 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <article>
        {/* Header Section */}
        <header class="mb-8 text-center">
          <div class="flex flex-wrap justify-center items-center gap-3 text-sm text-gray-500 mb-4">
             <span class="bg-primary-50 text-primary-700 px-3 py-1 rounded-full font-medium">
               {post.category}
             </span>
             <span aria-hidden="true">&bull;</span>
             <time datetime={post.date}>{formatDate(post.date)}</time>
             {showUpdated && (
               <>
                 <span aria-hidden="true">&bull;</span>
                 <time datetime={post.dateModified}>Updated {formatDate(post.dateModified!)}</time>
               </>
             )}
          </div>

          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-heading text-gray-900 mb-6 leading-tight">
            {post.title}
          </h1>

          <div class="text-gray-600 font-medium">
            By {post.author}
          </div>
        </header>

        {/* Featured Image */}
        {post.image && (
          <div class="mb-10 rounded-xl overflow-hidden shadow-lg mx-auto max-w-3xl">
            {isAstroImage ? (
              <Image
                // @ts-ignore
                src={post.image}
                alt={imageAlt}
                class="w-full h-auto object-cover"
                loading="eager"
                width={1024}
                height={576}
              />
            ) : (
              <img
                // @ts-ignore
                src={post.image}
                alt={imageAlt}
                class="w-full h-auto object-cover"
              />
            )}
          </div>
        )}

        {/* Content Body */}
        <div class="prose prose-lg prose-primary mx-auto text-gray-700" set:html={post.content} />

        {/* Appointment CTA */}
        <div class="mt-14 bg-primary-50 rounded-xl p-8 text-center">
          <h2 class="text-2xl font-heading font-bold text-gray-900 mb-3">
            Questions about your smile?
          </h2>
          <p class="text-gray-600 mb-6 max-w-xl mx-auto">
            Our team at {clinicInfo.name} in South Austin is happy to help you figure out the next step — no pressure, just answers.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <Button
              href={clinicInfo.booking.primary}
              bookingProvider={clinicInfo.booking.provider}
              text="Book an Appointment"
              variant="primary"
              size="lg"
              target="_blank"
              rel="noopener noreferrer"
            />
            <a href={`tel:${clinicInfo.phone.replace(/[^0-9+]/g, '')}`} class="text-primary-700 font-semibold hover:text-primary-800 transition-colors py-2">
              or call {clinicInfo.displayPhone}
            </a>
          </div>
        </div>

        {/* Tags */}
        {post.tags && (
          <div class="mt-12 pt-6 border-t border-gray-100">
            <h2 class="text-sm font-semibold text-gray-500 mb-3 uppercase tracking-wider">Related Topics</h2>
            <div class="flex flex-wrap gap-2">
              {post.tags.map(tag => (
                <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-md text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        {/* Related Posts */}
        {related.length > 0 && (
          <section class="mt-14 pt-10 border-t border-gray-100" aria-label="Related articles">
            <h2 class="text-2xl font-heading font-semibold text-gray-900 mb-8 text-center">Keep Reading</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              {related.map(rp => (
                <a href={`/blog/${rp.id}`} class="group block">
                  {rp.image && typeof rp.image === 'object' && 'src' in rp.image && (
                    <div class="overflow-hidden rounded-lg aspect-[3/2] mb-4">
                      <Image
                        // @ts-ignore
                        src={rp.image}
                        alt={rp.imageAlt || rp.title}
                        width={600}
                        height={400}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                  )}
                  <div class="text-xs text-primary-600 font-bold uppercase tracking-wider mb-1">{rp.category}</div>
                  <h3 class="text-lg font-heading font-semibold text-gray-800 group-hover:text-primary-600 transition-colors leading-snug">
                    {rp.title}
                  </h3>
                </a>
              ))}
            </div>
          </section>
        )}

        {/* Back link */}
        <div class="mt-12 text-center">
          <a href="/blog" class="inline-flex items-center min-h-[44px] text-primary-600 hover:text-primary-800 font-semibold transition-colors">
            &larr; Back to Articles
          </a>
        </div>

      </article>
    </div>
  </div>
</Layout>
