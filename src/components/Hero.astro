---
import { Image } from 'astro:assets';
import { clinicInfo } from '../utils/clinicInfo';
import Button from './Button.astro';

export interface HeroImage {
  src: string | ImageMetadata;
  alt: string;
}

export interface Props {
  // Accepts either a plain src (back-compat) or { src, alt } for meaningful alts
  images?: (HeroImage | string | ImageMetadata)[];
  title?: string;
  subtitle?: string;
  overlay?: boolean;
  showAppointmentForm?: boolean;
  /** Call + Book buttons directly under the hero copy. Defaults on for the homepage. */
  showCtas?: boolean;
  isHomePage?: boolean;
  /** e.g. "⭐ 4.9 on Google · 200+ reviews" */
  trustSignal?: string;
  /**
   * Banner height on md+ screens. Below md the hero keeps a 16:9 ratio.
   * 'lg' is the homepage default; interior pages should use 'md' or 'sm'.
   * (Several pages already pass height="md" — this prop now actually works.)
   */
  height?: 'sm' | 'md' | 'lg';
}

const {
  images = [],
  title,
  subtitle,
  overlay = true,
  showAppointmentForm = false,
  showCtas,
  isHomePage = false,
  trustSignal,
  height = isHomePage ? 'lg' : 'md',
} = Astro.props;

// Fixed banner heights on md+ instead of a 16:9 ratio box. The old
// pb-[56.25%] scaled height linearly with viewport width, so on wide
// desktops the hero grew to ~1400px tall and filled the whole frame.
// Below md the 16:9 ratio is kept (it produces sensible heights there).
// Literal class strings so Tailwind's JIT can see them.
const slideHeightClass = {
  sm: 'relative pb-[56.25%] md:pb-0 md:h-[260px] lg:h-[300px]',
  md: 'relative pb-[56.25%] md:pb-0 md:h-[340px] lg:h-[400px]',
  lg: 'relative pb-[56.25%] md:pb-0 md:h-[440px] lg:h-[500px] xl:h-[540px]',
}[height];

// Normalize images so every slide has meaningful alt text.
// Back-compat: raw strings / ImageMetadata still work, but fall back to a
// clinic-branded alt rather than "Dental care image N" (which is bad for both
// SEO and accessibility).
const normalizedImages: HeroImage[] = images.map((img, i) => {
  if (img && typeof img === 'object' && 'src' in img && 'alt' in img) {
    return img as HeroImage;
  }
  return {
    src: img as string | ImageMetadata,
    alt: `${clinicInfo.name} office – photo ${i + 1}`,
  };
});

const resolvedTitle = title || (isHomePage ? `Welcome to ${clinicInfo.name}` : '');
const resolvedSubtitle = subtitle || (isHomePage ? 'Your trusted partner in dental care' : '');
const rawPhone = clinicInfo.phone.replace(/\D/g, '');
// Default on for the homepage: 60% of visitors land there and the first booking
// action was ~2,900px down the page.
const renderCtas = showCtas ?? (isHomePage && !showAppointmentForm);
const headingId = 'hero-heading';
---

<section
  class={`relative ${isHomePage ? 'mt-[60px] md:mt-32' : 'mt-[60px] md:mt-24'}`}
  aria-labelledby={resolvedTitle ? headingId : undefined}
  aria-label={resolvedTitle ? undefined : 'Hero'}
>
  <div class={showAppointmentForm ? 'container mx-auto px-4 max-w-7xl' : ''}>
    <div class={showAppointmentForm ? 'grid grid-cols-12 gap-4 sm:gap-8' : ''}>
      <div class={`${showAppointmentForm ? 'col-span-12 lg:col-span-8' : 'w-full'} relative`}>

        {resolvedTitle && (
          <div class={`mb-6 sm:mb-8 text-center ${!showAppointmentForm ? 'container mx-auto px-4 max-w-5xl' : ''}`}>
            <h1
              id={headingId}
              class={`font-bold font-heading mb-3 sm:mb-4 text-gray-800 ${
                isHomePage ? 'text-3xl md:text-4xl lg:text-5xl' : 'text-3xl md:text-4xl'
              }`}
            >
              {resolvedTitle}
            </h1>

            {resolvedSubtitle && (
              <p class="text-lg md:text-xl text-gray-600 mb-4">{resolvedSubtitle}</p>
            )}

            {trustSignal && (
              <p class="text-sm md:text-base text-gray-700 font-medium mb-6">
                {trustSignal}
              </p>
            )}

            {renderCtas && (
              <div
                data-cta-zone="hero"
                class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 mt-6"
              >
                <Button href={`tel:${rawPhone}`} text={`Call ${clinicInfo.displayPhone}`} variant="primary" size="lg" />
                <Button
                  href={clinicInfo.booking.primary}
                  bookingProvider={clinicInfo.booking.provider}
                  text="Book Online"
                  variant="outline"
                  size="lg"
                  target="_blank"
                  rel="noopener noreferrer"
                />
              </div>
            )}

          </div>
        )}

        {/* On md+ the banner is constrained to the content column and rounded,
            so ultra-wide monitors get a framed banner instead of an
            edge-to-edge wall of image. */}
        <div class={showAppointmentForm ? '' : 'md:container md:mx-auto md:px-4 md:max-w-7xl'}>
        <div class={`relative w-full overflow-hidden bg-gray-100 min-h-[200px] ${showAppointmentForm ? 'rounded-lg' : 'md:rounded-2xl'}`}>
          <div class="swiper heroSwiper" data-hero-swiper>
            <div class="swiper-wrapper">
              {normalizedImages.map((image, index) => (
                <div class="swiper-slide">
                  <div class={slideHeightClass}>
                    <Image
                      src={image.src}
                      alt={image.alt}
                      class="absolute inset-0 w-full h-full object-cover object-center"
                      widths={[640, 768, 1024, 1280, 1920]}
                      sizes="(max-width: 767px) 100vw, (max-width: 1311px) calc(100vw - 32px), 1248px"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      fetchpriority={index === 0 ? 'high' : 'low'}
                      format="webp"
                      quality={85}
                      decoding={index === 0 ? 'sync' : 'async'}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>

          {overlay && <div class="absolute inset-0 bg-gray-900 bg-opacity-20 pointer-events-none"></div>}

          <div class="swiper-pagination" data-hero-pagination></div>
        </div>
        </div>
      </div>

      {showAppointmentForm && (
        <aside class="col-span-12 lg:col-span-4" aria-label="Appointment request">
          <div class="bg-white rounded-lg shadow-lg p-6" data-aos="fade-left">
            <h2 class="text-2xl font-bold text-primary-600 text-center mb-6">Request an Appointment</h2>
            <form id="appointment-form" class="space-y-4" novalidate>
              <div>
                <label for="full-name" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                <input type="text" id="full-name" name="fullName" required autocomplete="name"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500"
                  placeholder="Enter your full name" />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                  <input type="email" id="email" name="email" required autocomplete="email"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500"
                    placeholder="Your email" />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                  <input type="tel" id="phone" name="phone" required autocomplete="tel"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500"
                    placeholder="Your phone" />
                </div>
              </div>

              <div>
                <label for="dob" class="block text-sm font-medium text-gray-700 mb-1">Date of Birth</label>
                <input type="date" id="dob" name="dob" required autocomplete="bday"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="date" class="block text-sm font-medium text-gray-700 mb-1">Preferred Date</label>
                  <input type="date" id="date" name="preferredDate" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500" />
                </div>
                <div>
                  <label for="time" class="block text-sm font-medium text-gray-700 mb-1">Preferred Time</label>
                  <select id="time" name="preferredTime" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500">
                    <option value="">Select a time</option>
                    <option value="morning">Morning (8:00 AM - 12:00 PM)</option>
                    <option value="afternoon">Afternoon (12:00 PM - 5:00 PM)</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="reason" class="block text-sm font-medium text-gray-700 mb-1">Reason for Visit</label>
                <select id="reason" name="reasonForVisit" required
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary-500">
                  <option value="">Select a reason</option>
                  <option value="checkup">Regular Checkup</option>
                  <option value="cleaning">Teeth Cleaning</option>
                  <option value="emergency">Dental Emergency</option>
                  <option value="consultation">Consultation</option>
                  <option value="other">Other</option>
                </select>
              </div>

              {/* TCPA: SMS consent must be optional and cannot be a condition of service. */}
              <div class="flex items-start">
                <input type="checkbox" id="consent" name="smsConsent"
                  class="mt-1 h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" />
                <label for="consent" class="ml-2 block text-sm text-gray-700">
                  I agree to receive appointment-related text messages from {clinicInfo.name}.
                  Msg &amp; data rates may apply. Reply STOP to opt out. <span class="text-gray-500">(Optional)</span>
                </label>
              </div>

              <p class="text-xs text-red-600 font-medium mt-3">
                <span class="font-bold">Please Note:</span> A $25 fee applies to cancellations made with less than 24 hours' notice.
              </p>

              <p class="text-xs text-gray-500 mt-2">
                This form is protected by reCAPTCHA and the Google
                <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">Privacy Policy</a> and
                <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">Terms of Service</a> apply.
              </p>

              <div id="form-status" role="status" aria-live="polite" class="text-sm min-h-[1.25rem]"></div>

              <button type="submit"
                class="w-full bg-primary-600 text-white py-2 px-4 rounded-md hover:bg-primary-700 transition-colors duration-200 disabled:opacity-60 disabled:cursor-not-allowed">
                <span data-submit-label>Request Appointment</span>
              </button>
            </form>
          </div>
        </aside>
      )}
    </div>
  </div>
</section>

<script>
  import { submitForm } from '../utils/forms';
  import Swiper from 'swiper';
  import { Autoplay, Pagination } from 'swiper/modules';

  // --- Hero carousel ---------------------------------------------------------
  // Scope queries to this component via data attributes so multiple heroes on
  // a page don't collide, and so the old global `.heroSwiper` / `.swiper-pagination`
  // selectors don't accidentally match other carousels.
  const heroEl = document.querySelector<HTMLElement>('[data-hero-swiper]');
  const paginationEl = document.querySelector<HTMLElement>('[data-hero-pagination]');

  if (heroEl && paginationEl) {
    const slideCount = heroEl.querySelectorAll('.swiper-slide').length;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const shouldLoop = slideCount > 1;
    const shouldAutoplay = shouldLoop && !reduceMotion;

    new Swiper(heroEl, {
      modules: [Autoplay, Pagination],
      slidesPerView: 1,
      loop: shouldLoop,
      speed: 800,
      autoplay: shouldAutoplay
        ? { delay: 3500, disableOnInteraction: false, pauseOnMouseEnter: true }
        : false,
      pagination: shouldLoop
        ? { el: paginationEl, clickable: true, type: 'bullets' }
        : false,
      effect: 'slide',
      watchSlidesProgress: true,
    });
  }

  // --- Appointment form ------------------------------------------------------
  const appointmentForm = document.getElementById('appointment-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');

  if (appointmentForm && statusEl) {
    const submitBtn = appointmentForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = appointmentForm.querySelector<HTMLElement>('[data-submit-label]');
    const originalLabel = submitLabel?.textContent || 'Request Appointment';

    const setStatus = (message: string, tone: 'idle' | 'success' | 'error' = 'idle') => {
      statusEl.textContent = message;
      const toneClass =
        tone === 'success' ? 'text-green-700' :
        tone === 'error' ? 'text-red-700' : 'text-gray-600';
      statusEl.className = `text-sm min-h-[1.25rem] ${toneClass}`;
    };

    appointmentForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!appointmentForm.checkValidity()) {
        appointmentForm.reportValidity();
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Submitting…';
      setStatus('');

      try {
        const formData = new FormData(appointmentForm);
        const data = Object.fromEntries(formData.entries());
        // Checkbox submits nothing when unchecked; normalize to explicit flag.
        const consentEl = appointmentForm.elements.namedItem('smsConsent') as HTMLInputElement | null;
        data.smsConsent = consentEl?.checked ? 'yes' : 'no';

        await submitForm({ ...data, formType: 'appointment' });

        setStatus("Thanks! We've received your request and will reach out shortly.", 'success');
        appointmentForm.reset();
      } catch (error) {
        console.error('Error submitting appointment form:', error);
        setStatus('Something went wrong. Please call us or try again.', 'error');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitLabel) submitLabel.textContent = originalLabel;
      }
    });
  }
</script>

<style>
  .heroSwiper {
    width: 100%;
    height: 100%;
  }

  .swiper-wrapper {
    display: flex;
  }

  .swiper-slide {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
  }

  .swiper-pagination {
    position: absolute !important;
    bottom: 20px !important;
    left: 0 !important;
    right: 0 !important;
    text-align: center !important;
    z-index: 20 !important;
    display: flex !important;
    justify-content: center !important;
    gap: 8px !important;
  }

  @media (min-width: 768px) {
    .swiper-pagination {
      bottom: 24px !important;
    }
  }

  .swiper-pagination-bullet {
    background: white !important;
    opacity: 0.7 !important;
    width: 12px !important;
    height: 12px !important;
    border-radius: 50% !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
    display: inline-block !important;
  }

  .swiper-pagination-bullet:hover {
    opacity: 0.9 !important;
    transform: scale(1.2) !important;
  }

  .swiper-pagination-bullet-active {
    opacity: 1 !important;
    background: white !important;
    transform: scale(1.3) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .swiper-wrapper {
      transition: none !important;
    }
  }
</style>
