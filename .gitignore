# Node and build artifacts
node_modules/
dist/

# Sensitive files
.env
.env.*
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# OS-specific files
.DS_Store
Thumbs.db

# IDE / Editor specific directories and files
.vscode/
.idea/
.codesandbox/
.bolt/

# Infrastructure (exclude unless intentional)
infrastructure/
terraform.tfstate
terraform.tfstate.backup
*.tfvars

# Astro build cache or temporary files (if any specific to Astro)
.cache/

.astro/
.bolt/
.codesandbox/
.vscode/

# Python (test suites under marketing/ads write bytecode next to the sources)
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/

# Terraform working directories and variable files.
# terraform.tfstate is already ignored above; .terraform/ holds provider
# binaries and cached backend config, and *.tfvars routinely holds secrets.
# NOTE: .terraform.lock.hcl is deliberately NOT ignored — it pins provider
# versions and belongs in version control for reproducible plans.
.terraform/
*.tfvars
*.tfvars.json
crash.log

# Local transfer artifacts. Files downloaded to the box arrive with the
# punctuation stripped from their names (install-x.txt -> installx.txt), so
# these patterns are deliberately loose.
*.bundle
*.tar.gz
*.patch
install*.txt
install*.sh
